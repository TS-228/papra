# syntax=docker/dockerfile:1
#
# linux/arm/v7 Papra image.
#
# Official Node.js no longer publishes linux/arm/v7 binaries (dropped from
# Node 24+). The runtime uses the unofficial armv7l Node image built from
# Debian slim by https://github.com/TS-228/unofficial-builds
# (ghcr.io/ts-228/unofficial-builds/node-armv7l).
#
# Papra JS is compiled on the build host (official linux-x64 Node) so the
# Vite/esbuild work does not run under QEMU. Native addons are installed on
# the armv7 stage.
#
# Build:
#   docker buildx build --platform linux/arm/v7 \
#     --target papra-rootless \
#     -f packages/app/Dockerfile.armv7 \
#     --build-arg PAPRA_VERSION=26.6.1 \
#     -t ghcr.io/ts-228/papra:26.6.1-armv7 .

ARG HOST_NODE_IMAGE=node:26-slim@sha256:a1d9d671994fc2d26e297ac56b4b1522a8bc7fa71c43b14cd1b1fe6c5116f7dc
ARG NODE_IMAGE=ghcr.io/ts-228/unofficial-builds/node-armv7l:latest

# -----------------------------------------------------------------------------
# Compile Papra (client + server) on the build host.
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ${HOST_NODE_IMAGE} AS papra-build
ARG PNPM_VERSION=11.22.0

RUN npm install -g "pnpm@${PNPM_VERSION}"

WORKDIR /app

COPY pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY apps/papra-client/package.json apps/papra-client/package.json
COPY apps/papra-server/package.json apps/papra-server/package.json
COPY packages/webhooks/package.json packages/webhooks/package.json
COPY packages/lecture/package.json packages/lecture/package.json
COPY packages/std/package.json packages/std/package.json
COPY packages/search-parser/package.json packages/search-parser/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

RUN pnpm --filter "@papra/app-client..." run build \
    && pnpm --filter "@papra/app-server..." run build

# Drop host-arch node_modules so the target stage can install armv7 natives.
RUN rm -rf node_modules \
        apps/*/node_modules \
        packages/*/node_modules \
        packages/*/demo/node_modules

# -----------------------------------------------------------------------------
# Unofficial linux/arm/v7 Node on Debian slim, plus toolchain for native addons.
# -----------------------------------------------------------------------------
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS runtime-base
ARG PNPM_VERSION=11.22.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libatomic1 \
        libstdc++6 \
        python3 \
        python-is-python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "pnpm@${PNPM_VERSION}"

# -----------------------------------------------------------------------------
# Install production deps (including native addons) for linux/arm/v7.
# -----------------------------------------------------------------------------
FROM runtime-base AS papra-deploy

WORKDIR /app

ENV NODE_ENV=production

COPY --from=papra-build /app /app

# libsql 0.4.x (pulled by @libsql/client) has no linux-arm-gnueabihf binary and a
# different native ABI. Install 0.5.29 outside the workspace (catalog: protocol
# breaks npm install in the deployed tree) so JS and the armv7 addon match.
RUN pnpm install --frozen-lockfile --filter="@papra/app-server..." \
    && pnpm deploy --filter=@papra/app-server --legacy --prod /prod/papra-server \
    && mkdir -p /tmp/libsql-arm \
    && cd /tmp/libsql-arm \
    && npm init -y \
    && npm install --omit=dev libsql@0.5.29 @libsql/linux-arm-gnueabihf@0.5.29 \
    && rm -rf /prod/papra-server/node_modules/libsql \
              /prod/papra-server/node_modules/@libsql/linux-arm-gnueabihf \
    && cp -a node_modules/libsql /prod/papra-server/node_modules/libsql \
    && mkdir -p /prod/papra-server/node_modules/@libsql \
    && cp -a node_modules/@libsql/linux-arm-gnueabihf \
          /prod/papra-server/node_modules/@libsql/linux-arm-gnueabihf \
    && node -e "const p=require('/prod/papra-server/node_modules/libsql/package.json'); if (p.version!=='0.5.29') { throw new Error('expected libsql@0.5.29, got '+p.version); }"

# -----------------------------------------------------------------------------
# Rootful image
# -----------------------------------------------------------------------------
FROM runtime-base AS papra-root

ARG PAPRA_VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

WORKDIR /app

# Build tools are only needed while installing native modules.
RUN apt-get purge -y --auto-remove python3 python-is-python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=papra-deploy /prod/papra-server ./
COPY --from=papra-build /app/apps/papra-client/dist ./public
COPY pnpm-workspace.yaml ./

EXPOSE 1221

ENV PAPRA_VERSION=${PAPRA_VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE} \
    NODE_ENV=production \
    SERVER_SERVE_PUBLIC_DIR=true \
    DATABASE_URL=file:./app-data/db/db.sqlite \
    DOCUMENT_STORAGE_FILESYSTEM_ROOT=./app-data/documents \
    PAPRA_CONFIG_DIR=./app-data \
    EMAILS_DRY_RUN=true \
    CLIENT_BASE_URL=http://localhost:1221 \
    BETTER_AUTH_TELEMETRY=0

RUN mkdir -p ./app-data/db ./app-data/documents ./ingestion

CMD ["pnpm", "start:with-migrations"]

# -----------------------------------------------------------------------------
# Rootless image (default)
# -----------------------------------------------------------------------------
FROM runtime-base AS papra-rootless

ARG PAPRA_VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apt-get purge -y --auto-remove python3 python-is-python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r nonroot && useradd -r -g nonroot nonroot \
    && mkdir -p /home/nonroot \
    && chown -R nonroot:nonroot /home/nonroot

WORKDIR /app

RUN mkdir -p ./app-data/db ./app-data/documents \
    && chown -R nonroot:nonroot /app

USER nonroot

COPY --from=papra-deploy --chown=nonroot:nonroot /prod/papra-server ./
COPY --from=papra-build --chown=nonroot:nonroot /app/apps/papra-client/dist ./public
COPY --chown=nonroot:nonroot pnpm-workspace.yaml ./

EXPOSE 1221

ENV PAPRA_VERSION=${PAPRA_VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE} \
    NODE_ENV=production \
    SERVER_SERVE_PUBLIC_DIR=true \
    DATABASE_URL=file:./app-data/db/db.sqlite \
    DOCUMENT_STORAGE_FILESYSTEM_ROOT=./app-data/documents \
    PAPRA_CONFIG_DIR=./app-data \
    INGESTION_FOLDER_ROOT=./ingestion \
    EMAILS_DRY_RUN=true \
    CLIENT_BASE_URL=http://localhost:1221 \
    BETTER_AUTH_TELEMETRY=0

CMD ["pnpm", "start:with-migrations"]
